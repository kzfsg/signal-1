# Copy to .env.local (and add the same names in Vercel: `vercel env add`). Server-side only.

# Fireworks: runs every agent (yours, the counterparts', the filter). fireworks.ai → API Keys
FIREWORKS_API_KEY=
# Muse Glimmer 30B is on-demand only on Fireworks: deploy it, then put the deployment's model id here.
# FIREWORKS_MODEL=accounts/fireworks/models/muse-glimmer-30b

# OpenRouter: Jev (TypeSafe) makes the meet/skip call; without a key Muse decides. openrouter.ai → Keys
OPENROUTER_API_KEY=
# JEV_MODEL=typesafe/jev-router

# Composio: LinkedIn, Gmail and Google Calendar connections. platform.composio.dev → Settings → API Keys
COMPOSIO_API_KEY=
# SIGNAL_USER_ID=ari   # the Composio user the connections belong to

# Dial: the agent's phone line. `curl -fsSL https://getdial.ai/install | bash && dial auth login <email>`
DIAL_API_KEY=
# Printed by `npm run dial:setup -- https://<app>.vercel.app`
DIAL_NUMBER_ID=
# A second Dial number for the counterpart agents Signal hosts, so meeting turns go number to number
DIAL_COUNTERPART_NUMBER_ID=
DIAL_WEBHOOK_SECRET=

# Keewano: networking history and insights. app.keewano.com (send #SpeedHacks in the in-app chat to lift limits)
KEEWANO_API_KEY=       # Settings → Project → API Keys, type SDK (writes)
KEEWANO_PAT=           # Settings → Personal → Security, kwpat-… (reads: SQL + MCP)
KEEWANO_EMAIL=         # the email you signed up with (SQL user)
KEEWANO_PROJECT_ID=    # Settings → Details → Project ID (UUID)

